def linear_search(arr, target):
      for i in range(len(arr)):
          if arr[i] == target:
              return i
      return -1
  
arr = ['rice','sugar','milk','oil']
target ='milk'
result = linear_search(arr, target)
  
if result != -1:
      print(f"product found at index")
else:
      print("product not found")
  
